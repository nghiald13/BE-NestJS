{
  "name": "nest-app",
  "version": "0.0.1",
  "description": "",
  "author": "Lê Đại Nghĩa",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:debug:gateway": "nest start api-gateway --debug 9229 --watch",
    "start:debug:auth": "nest start auth-service --debug 9230 --watch",
    "start:debug:media": "nest start media-service --debug 9231 --watch",
    "start:debug:product": "nest start product-service --debug 9232 --watch",
    "start:debug:order": "nest start order-service --debug 9233 --watch",
    "start:debug:payment": "nest start payment-service --debug 9234 --watch",
    "start:prod": "node dist/apps/nest-app/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/nest-app/test/jest-e2e.json"
  },
  "dependencies": {
    "@cacheable/memory": "2.0.9",
    "@keyv/redis": "5.1.6",
    "@nestjs-modules/mailer": "2.3.4",
    "@nestjs/axios": "4.0.1",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@types/passport-google-oauth20": "^2.0.17",
    "api-query-params": "6.1.0",
    "bcrypt": "6.0.0",
    "cache-manager": "7.2.8",
    "cacheable": "2.3.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cloudinary": "2.10.0",
    "cookie-parser": "^1.4.7",
    "dayjs": "1.11.20",
    "handlebars": "4.7.9",
    "kafkajs": "^2.2.4",
    "keyv": "5.6.0",
    "mongoose": "8.23.1",
    "nodemailer": "8.0.7",
    "otplib": "13.4.0",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "query-string": "9.4.0",
    "redis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "streamifier": "^0.1.1",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-local": "^1.0.38",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "jest": "30.3.0",
    "prettier": "3.8.3",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      ".+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}
